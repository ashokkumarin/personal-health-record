{
  "name": "@phr/api",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/server.js",
    "test": "dotenv -e .env.test -- vitest run",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.0",
    "@phr/shared": "*",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.11.2",
    "jsonwebtoken": "^9.0.2",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "dotenv-cli": "^7.4.2",
    "form-data": "^4.0.6",
    "prisma": "^5.18.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6"
  }
}
