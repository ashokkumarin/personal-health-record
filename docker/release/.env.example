# Copy to .env alongside docker-compose.yml, then fill these in before
# `docker compose up -d`.

# Pin this to a released version tag once you've picked one, e.g. v1.2.3.
# Leave as `latest` only if you're comfortable tracking main.
PHR_VERSION=latest

# Generate a real secret, e.g.: openssl rand -base64 48
JWT_SECRET=

# Ports to expose on this host. Change if 3000/4000 are already taken.
API_PORT=4000
WEB_PORT=3000

# How *your browser* reaches this host — not container-internal addresses.
# e.g. http://192.168.1.50:4000 and http://192.168.1.50:3000 for a homelab box.
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Bootstrapped as an admin account on every API startup (idempotent — safe to
# leave as-is after first run). Change the password here and restart to
# rotate it; the admin can also change it from the app afterwards.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=changepassword12345
