generator client {
  provider      = "prisma-client-js"
  // native covers host dev (Windows); debian-openssl-3.0.x covers the docker
  // runtime image (node:22-bookworm-slim) regardless of whether openssl happens
  // to be installed in the build stage when `prisma generate` runs.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  avatarPath   String?
  themeColor   String?
  defaultTimelineView String?
  dateOfBirth  DateTime?
  address      String?
  // System-level admin flag — distinct from FamilyRole (per-family
  // OWNER/ADMIN/MEMBER). Seeded from ADMIN_EMAIL/ADMIN_PASSWORD on startup.
  isAdmin      Boolean  @default(false)
  // Set when an admin creates the account or resets its password; cleared
  // the next time the user successfully changes their own password.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  ownedFamilies             Family[]           @relation("FamilyOwner")
  familyMemberships         FamilyMembership[]
  linkedPatientProfile      PatientProfile?
  approvalRequestsReceived  ApprovalRequest[]  @relation("ApprovalTarget")
  approvalRequestsRequested ApprovalRequest[]  @relation("ApprovalRequestedBy")
  uploadedRecords           MedicalRecord[]
  auditLogs                 AuditLog[]
  devices                   Device[]
  passwordResetRequests     PasswordResetRequest[] @relation("PasswordResetRequester")
  resolvedPasswordResets    PasswordResetRequest[] @relation("PasswordResetResolver")
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  PENDING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Family {
  id        String    @id @default(uuid())
  // Uniqueness on name is enforced only among non-deleted families via a
  // partial unique index (see migration family_name_unique_active_only) —
  // Prisma's schema DSL can't express a partial/filtered unique index, so
  // there's deliberately no @unique here; a plain one would block reusing a
  // name after a soft delete.
  name      String
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner       User               @relation("FamilyOwner", fields: [ownerId], references: [id])
  memberships FamilyMembership[]
  patients    PatientProfile[]
}

model FamilyMembership {
  id        String           @id @default(uuid())
  familyId  String
  userId    String
  role      FamilyRole
  status    MembershipStatus @default(ACTIVE)
  relation  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  // Soft delete so a sync client can be told a membership went away (see
  // AuditLog/Device). Note this means re-adding a previously-removed user to
  // the same family will hit the unique constraint below — same limitation
  // Family's name uniqueness had before its partial-index fix; not solved
  // here since removing-then-re-adding the same member is a rare edge case.
  deletedAt DateTime?

  family Family @relation(fields: [familyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([familyId, userId])
}

model PatientProfile {
  id              String    @id @default(uuid())
  familyId        String
  linkedUserId    String?   @unique
  name            String
  dateOfBirth     DateTime?
  gender          String?
  visibleToFamily Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  family           Family            @relation(fields: [familyId], references: [id])
  linkedUser       User?             @relation(fields: [linkedUserId], references: [id])
  approvalRequests ApprovalRequest[]
  records          MedicalRecord[]
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  patientId     String
  targetUserId  String
  requestedById String
  status        ApprovalStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  respondedAt   DateTime?

  patient     PatientProfile @relation(fields: [patientId], references: [id])
  targetUser  User           @relation("ApprovalTarget", fields: [targetUserId], references: [id])
  requestedBy User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
}

enum RecordType {
  PRESCRIPTION
  LAB_REPORT
  PHARMACY_BILL
  NOTE
}

model MedicalRecord {
  id            String     @id @default(uuid())
  patientId     String
  recordType    RecordType
  title         String
  filePath      String
  fileType      String
  thumbnailPath String?
  ocrText       String?
  capturedAt    DateTime?
  uploadedAt    DateTime   @default(now())
  createdById   String
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  patient   PatientProfile @relation(fields: [patientId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
}

enum AuditActorType {
  USER
  DEVICE
}

enum AuditEventType {
  LOGIN
  LOGOUT
  REGISTER
  UPLOAD
  EDIT
  DELETE
  ADMIN_CREATE_USER
  ADMIN_UPDATE_USER
  ADMIN_DELETE_USER
  ADMIN_RESET_PASSWORD
  PASSWORD_RESET_REQUESTED
  PASSWORD_CHANGED
}

enum AuditSource {
  WEB
  MOBILE
  API
}

model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType
  userId     String?
  deviceId   String?
  eventType  AuditEventType
  entityType String?
  entityId   String?
  metadata   Json?
  source     AuditSource
  // Client-generated id for mobile-originated entries so a retried
  // /audit/sync batch (Phase 4) can be applied idempotently; null for
  // entries the server produces directly (login/logout/global hook).
  clientId   String?        @unique
  createdAt  DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id])
}

enum PasswordResetStatus {
  PENDING
  RESOLVED
}

model PasswordResetRequest {
  id           String              @id @default(uuid())
  userId       String
  status       PasswordResetStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  user       User  @relation("PasswordResetRequester", fields: [userId], references: [id])
  resolvedBy User? @relation("PasswordResetResolver", fields: [resolvedById], references: [id])
}

model Device {
  id           String    @id @default(uuid())
  userId       String
  installId    String    @unique
  label        String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}
