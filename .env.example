DATABASE_URL=postgresql://phr:phr@localhost:5432/phr
TEST_DATABASE_URL=postgresql://phr:phr@localhost:5432/phr_test
JWT_SECRET=dev-only-change-me

# Bootstrapped as an admin account on every API startup (idempotent — safe to
# leave as-is after first run). Change the password here and restart to
# rotate it; the admin can also change it from the app afterwards.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=changepassword12345
# Folder where uploaded documents/thumbnails/avatars are stored. Point this at a
# bind-mounted/docker volume path (e.g. an absolute host path) in non-local setups.
MEDIA_ROOT=./data/media

# Host ports docker-compose publishes the api/web containers on. Change these if
# 3000/4000 are already taken on your server — no rebuild required, just
# `docker compose up -d` again.
API_PORT=4000
WEB_PORT=3000

# Base URL the API is reachable at from a browser — used to build file download links.
# When running via docker-compose, set this to how *your browser* reaches the host,
# e.g. http://<homelab-ip>:${API_PORT}.
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# The web app calls the API through a same-origin /api proxy (see
# apps/web/app/api/[...path]/route.ts), so this normally doesn't need to be set.
# Uncomment only to make the browser call the API directly instead of going through
# the proxy.
# NEXT_PUBLIC_API_URL=http://localhost:4000
